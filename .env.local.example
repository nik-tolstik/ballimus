# Local-only PostgreSQL settings for the Phase 1 development and test path.
# Copy this file to .env.local. Never use these values for production services.
POSTGRES_DB=football_local
POSTGRES_USER=football_local
POSTGRES_PASSWORD=football_local_dev_password
POSTGRES_HOST_PORT=54329

# Host-run API processes and tests should use this local loopback URL.
# Keep it synchronized with the PostgreSQL settings above if you change them.
DATABASE_URL=postgresql://football_local:football_local_dev_password@127.0.0.1:54329/football_local

# Other application settings belong here only when they are local/test values.
GROUP_TIMEZONE=Europe/Minsk
LOG_LEVEL=debug
TELEGRAM_MINI_APP_INIT_DATA_MAX_AGE_SECONDS=86400
