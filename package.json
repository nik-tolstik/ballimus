{
  "name": "football-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram football match coordination bot",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "pnpm exec vitest run",
    "lint": "pnpm run typecheck && pnpm exec oxlint src tests drizzle.config.ts vitest.config.ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec tsx --env-file=.env src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.76.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "luxon": "^3.7.2",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  }
}
