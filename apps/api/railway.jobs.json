{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @football/api... build",
    "watchPatterns": [
      "apps/api/**",
      "packages/db/**",
      "packages/domain/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.base.json",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @football/api jobs:start",
    "restartPolicyType": "NEVER",
    "cronSchedule": "*/5 * * * *",
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    }
  }
}
