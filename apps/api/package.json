{
  "name": "@football/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS API platform for Ballimus.",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "pnpm exec oxlint src",
    "test": "pnpm exec vitest run --passWithNoTests --config vitest.config.ts",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "build": "pnpm exec tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "openapi:write": "node ../../scripts/run-tsx.mjs src/openapi.ts --write",
    "jobs:run": "node ../../scripts/run-tsx.mjs src/jobs/cli.ts",
    "jobs:start": "node dist/jobs/cli.js",
    "telegram:webhook:set": "node dist/telegram/webhook-config-cli.js"
  },
  "dependencies": {
    "@football/db": "workspace:*",
    "@football/domain": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "grammy": "^1.45.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
