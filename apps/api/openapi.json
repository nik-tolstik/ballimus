  "info": {
    "title": "Football Bot API",
    "description": "Owner-facing REST API for the Football Telegram Mini App.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "telegramMiniApp": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Telegram-Init-Data",
        "description": "Raw Telegram.WebApp.initData. The server validates its HMAC and owner identity."
      }
    },
    "schemas": {
      "OwnerIdentityResponseDto": {
        "type": "object",
        "properties": {
          "telegramUserId": {
            "type": "string",
            "example": "123456789"
          }
        },
        "required": [
          "telegramUserId"
        ]
      },
      "GroupConfigurationResponseDto": {
        "type": "object",
        "properties": {
          "telegramChatId": {
            "type": "string",
            "example": "-1001234567890"
          },
          "generalTopicId": {
            "type": "string",
            "example": "1"
          },
          "weatherTopicId": {
            "type": "string",
            "example": "42"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Minsk"
          }
        },
        "required": [
          "telegramChatId",
          "generalTopicId",
          "weatherTopicId",
          "timezone"
        ]
      },
      "MatchScheduleResponseDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-08-03"
          },
          "time": {
            "type": "string",
            "example": "20:00"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Minsk"
          }
        },
        "required": [
          "date",
          "time",
          "timezone"
        ]
      },
      "VenueBookingContactResponseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VenueResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "15"
          },
          "name": {
            "type": "string"
          },
          "mapUrl": {
            "type": "string",
            "format": "uri"
          },
          "venueType": {
            "type": "string",
            "enum": [
              "outdoor",
              "indoor"
            ]
          },
          "bookingContacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VenueBookingContactResponseDto"
            }
          },
          "websiteUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "version": {
            "type": "number",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "mapUrl",
          "venueType",
          "bookingContacts",
          "websiteUrl",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "PublicCardResponseDto": {
        "type": "object",
        "properties": {
          "publicationState": {
            "type": "string",
            "enum": [
              "not_published",
              "pending",
              "published",
              "uncertain",
              "failed",
              "deleted"
            ]
          },
          "telegramMessageId": {
            "type": "string",
            "nullable": true
          },
          "publicationAttemptedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "lastError": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "publicationState",
          "telegramMessageId",
          "publicationAttemptedAt",
          "lastError"
        ]
      },
      "MatchResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "42"
          },
          "chatId": {
            "type": "string",
            "example": "-1001234567890"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "schedule": {
            "$ref": "#/components/schemas/MatchScheduleResponseDto"
          },
          "durationMinutes": {
            "type": "number",
            "minimum": 15,
            "maximum": 480
          },
          "venue": {
            "$ref": "#/components/schemas/VenueResponseDto"
          },
          "fieldPriceRubles": {
            "type": "number",
            "nullable": true,
            "minimum": 0
          },
          "version": {
            "type": "number",
            "minimum": 1
          },
          "creatorTelegramUserId": {
            "type": "string",
            "example": "123456789"
          },
          "deletionRequestedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publicCard": {
            "$ref": "#/components/schemas/PublicCardResponseDto"
          }
        },
        "required": [
          "id",
          "chatId",
          "scheduledAt",
          "schedule",
          "durationMinutes",
          "venue",
          "fieldPriceRubles",
          "version",
          "creatorTelegramUserId",
          "deletionRequestedAt",
          "createdAt",
          "updatedAt",
          "publicCard"
        ]
      },
      "BootstrapResponseDto": {
        "type": "object",
        "properties": {
          "owner": {
            "$ref": "#/components/schemas/OwnerIdentityResponseDto"
          },
          "group": {
            "$ref": "#/components/schemas/GroupConfigurationResponseDto"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchResponseDto"
            }
          }
        },
        "required": [
          "owner",
          "group",
          "matches"
        ]
      },
      "MatchListResponseDto": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchResponseDto"
            }
          }
        },
        "required": [
          "matches"
        ]
      },
      "MatchEnvelopeResponseDto": {
        "type": "object",
        "properties": {
          "match": {
            "$ref": "#/components/schemas/MatchResponseDto"
          }
        },
        "required": [
          "match"
        ]
      },
      "MatchCreateDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-08-03",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "type": "string",
            "example": "20:00",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "durationMinutes": {
            "type": "number",
            "example": 90,
            "minimum": 15,
            "maximum": 480
          },
          "venueId": {
            "type": "string",
            "example": "15",
            "pattern": "^[1-9]\\d*$"
          },
          "fieldPriceRubles": {
            "type": "number",
            "nullable": true,
            "example": 25,
            "minimum": 0
          }
        },
        "required": [
          "date",
          "time",
          "durationMinutes",
          "venueId"
        ]
      },
      "PatchMatchDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-08-03",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "type": "string",
            "example": "20:00",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "durationMinutes": {
            "type": "number",
            "example": 90,
            "minimum": 15,
            "maximum": 480
          },
          "venueId": {
            "type": "string",
            "example": "15",
            "pattern": "^[1-9]\\d*$"
          },
          "fieldPriceRubles": {
            "type": "number",
            "nullable": true,
            "example": 25,
            "minimum": 0
          }
        }
      },
      "PollOptionResponseDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "notificationEnabled": {
            "type": "boolean"
          },
          "voterCount": {
            "type": "number",
            "minimum": 0
          },
          "notificationQueuedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "text",
          "notificationEnabled",
          "voterCount",
          "notificationQueuedAt"
        ]
      },
      "PollResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "42"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PollOptionResponseDto"
            }
          },
          "notificationThreshold": {
            "type": "number",
            "nullable": true,
            "minimum": 1
          },
          "isAnonymous": {
            "type": "boolean"
          },
          "allowsMultipleAnswers": {
            "type": "boolean"
